// 1776 FORGE — Cloudflare configuration.
// SAFETY: every binding below must point at NEW 1776 FORGE resources. Never reuse the legacy
// Baldwin Minute Watch Worker, D1 database, R2 bucket, routes or domain in any environment.
// The placeholder IDs make `wrangler deploy` fail until real NEW resource IDs are filled in.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1776-forge-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "development", "OWNER_EMAILS": "" },
  // Local development: `npm run db:migrate:local` creates this database under .wrangler/ only.
  "d1_databases": [
    { "binding": "DB", "database_name": "forge-db-dev", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "forge-documents-dev" }],

  "env": {
    "staging": {
      "name": "1776-forge-staging",
      "workers_dev": true,
      "vars": { "APP_ENV": "staging", "OWNER_EMAILS": "" },
      "d1_databases": [
        { "binding": "DB", "database_name": "forge-db-staging", "database_id": "REPLACE_WITH_NEW_STAGING_D1_ID", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "DOCS", "bucket_name": "forge-documents-staging" }],
      "triggers": { "crons": ["0 6 * * 1"] }
    },
    "production": {
      "name": "1776-forge",
      "workers_dev": false,
      "vars": { "APP_ENV": "production", "OWNER_EMAILS": "" },
      "d1_databases": [
        { "binding": "DB", "database_name": "forge-db", "database_id": "REPLACE_WITH_NEW_PRODUCTION_D1_ID", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "DOCS", "bucket_name": "forge-documents" }],
      "triggers": { "crons": ["0 6 * * 1"] }
      // Add "routes" for the NEW FORGE domain only after DNS is confirmed not to belong to the legacy site.
    }
  }
}
