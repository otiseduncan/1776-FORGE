{
  "name": "1776-forge-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "baldwinminutewatch.com", "custom_domain": true },
    { "pattern": "baldwinminutewatch.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "staging"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmw-consolidation-preview",
      "database_id": "2094ca37-49d8-4681-9512-6c54de847f09",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "bmw-consolidation-preview"
    }
  ],
  "services": [
    {
      "binding": "LEGACY_RECORDS",
      "service": "baldwin-minute-watch-v21"
    },
    {
      "binding": "LEGACY_MAP",
      "service": "bmw-legacy-consolidation-preview"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": []
  }
}
