{
  "name": "1776-forge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "baldwinminutewatch.com", "custom_domain": true },
    { "pattern": "www.baldwinminutewatch.com", "custom_domain": true },
    { "pattern": "baldwinminutewatch.org", "custom_domain": true },
    { "pattern": "www.baldwinminutewatch.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://baldwinminutewatch.com",
    "LEGACY_MAP_ORIGIN": "https://bmw-legacy-consolidation-preview.otiseduncan.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge-db",
      "database_id": "70520726-5e87-48e1-bf77-1b092bce0d59",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "forge-documents" }],
  "services": [
    { "binding": "LEGACY_RECORDS", "service": "baldwin-minute-watch-v21" },
    { "binding": "LEGACY_MAP", "service": "bmw-legacy-consolidation-preview" }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 6 * * 1"] }
}
