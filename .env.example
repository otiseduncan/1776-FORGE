# Copy to .dev.vars for LOCAL development only (`wrangler dev` reads it automatically).
# NEVER commit .dev.vars, tokens, OAuth client secrets or API keys.
# For staging/production use `npx wrangler secret put <NAME> --env <staging|production>`.

# Google OAuth "Web application" client; add http://localhost:8787/api/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails that become Owner on first sign-in.
OWNER_EMAILS=

# Optional Cloudflare Turnstile keys (posting works without them locally).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
