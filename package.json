{
  "name": "1776-forge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc -p . && node scripts/check-frontend.mjs",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "verify": "npm run check && npm test",
    "test:browser": "playwright test",
    "qa:snapshot": "node scripts/qa-snapshot.mjs",
    "qa:seed": "node --disable-warning=ExperimentalWarning scripts/qa-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "dev:session": "node scripts/dev-session.mjs",
    "deploy:staging": "npm run verify && wrangler deploy --env staging",
    "deploy:production": "npm run verify && wrangler deploy --env production",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@playwright/test": "^1.65.1",
    "leaflet": "^1.9.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
